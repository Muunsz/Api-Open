{
  "name": "@api-open/desktop",
  "version": "0.1.0",
  "description": "Api-Open Desktop Client",
  "author": "Api-Open",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "35.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.apiopen.desktop",
    "productName": "Api-Open",
    "electronVersion": "35.0.0",
    "npmRebuild": false,
    "files": ["main.js", "preload.js"],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web-dist"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "../web/public/API-OPEN-LOGO.ico"
    },
    "mac": {
      "target": "dmg",
      "identity": null,
      "icon": "../web/public/API-OPEN-LOGO.png"
    },
    "linux": {
      "target": "AppImage",
      "category": "Development",
      "icon": "../web/public/API-OPEN-LOGO.png"
    }
  }
}
